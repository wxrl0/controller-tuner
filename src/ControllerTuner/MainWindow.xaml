<Window x:Class="ControllerTuner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Controller Tuner" Width="480" Height="640" MinWidth="420">
  <DockPanel Margin="12">

    <StackPanel DockPanel.Dock="Top">
      <StackPanel Orientation="Horizontal">
        <Ellipse x:Name="Dot" Width="12" Height="12" Margin="0,0,8,0" Fill="Gray" />
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>
      <TextBlock x:Name="PadText" Margin="20,2,0,10" Foreground="Gray" />

      <DockPanel Margin="0,0,0,8">
        <Button DockPanel.Dock="Right" Content="Delete" Padding="8,2" Click="Delete_Click" />
        <Button DockPanel.Dock="Right" Content="Duplicate" Padding="8,2" Margin="4,0" Click="Duplicate_Click" />
        <ComboBox x:Name="ProfileBox" DisplayMemberPath="Name" SelectionChanged="ProfileBox_Changed" />
      </DockPanel>
      <TextBox x:Name="NameBox" Margin="0,0,0,8" ToolTip="Profile name"
               Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
      <CheckBox x:Name="BypassBox" Content="Bypass (send raw input, no tuning)" Click="Bypass_Click" />
    </StackPanel>

    <TextBlock x:Name="Live" DockPanel.Dock="Bottom" FontFamily="Consolas" Margin="0,8,0,0" />

    <TabControl Margin="0,10,0,0">
      <TabItem Header="Left stick"><ContentControl x:Name="LeftHost" Margin="10" /></TabItem>
      <TabItem Header="Right stick"><ContentControl x:Name="RightHost" Margin="10" /></TabItem>
      <TabItem Header="Triggers / misc"><ContentControl x:Name="TrigHost" Margin="10" /></TabItem>
    </TabControl>

  </DockPanel>
</Window>
